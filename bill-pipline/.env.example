# ============================================================================
# bill-pipline env
# ============================================================================
# Local: copy to .env, fill in values that point at the local Supabase stack.
# Prod:  GitHub Actions secrets (see .github/workflows/bill-*.yml).
# Same code runs against either — only the SECRET_API_KEY + SUPABASE_URL change.

# ---- required (all three workers) ----
SUPABASE_URL=http://127.0.0.1:54321
SECRET_API_KEY=

# ---- required (enrich) ----
OPENROUTER_API_KEY=

# ---- required (sync + pipeline) ----
CONGRESS_API_KEY=

# ---- optional (all three) ----
# Discord webhook for session embeds. Omit to silence Discord output.
DISCORD_WEBHOOK_URL=

# Wall-clock budget per invocation, in ms. The worker exits cleanly once
# this much time has elapsed and trusts the next cron tick to continue.
# Defaults: 540000 (9 min) for enrich/pipeline, 1500000 (25 min) for sync.
TIME_BUDGET_MS=

# ---- optional (enrich) ----
# BATCH_SIZE=20
# PER_BATCH_CONCURRENCY=10

# ---- optional (sync) ----
# api | csv. Defaults to api. Set to csv for one-shot backfill from Storage.
# SYNC_SOURCE=api
# Free-text reason for manual runs (shown in Discord embed).
# SYNC_REASON=
# Storage bucket + filename for CSV-mode backfill.
# CSV_BUCKET_NAME=csv-data
# KICKSTART_CSV_NAME=all_bills.csv

# ---- optional (pipeline) ----
# Semicolon-separated HH:MM-HH:MM PT windows during which the worker no-ops.
# Empty / unset = always active.
# BLACKOUT_WINDOWS=06:30-09:00;15:30-18:30
# PGMQ visibility-retry threshold; messages with read_ct >= MAX_READS are
# archived (dropped) rather than re-tried.
# MAX_READS=5
